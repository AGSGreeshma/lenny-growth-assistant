# Base URL the frontend calls for the backend API. Read at build/dev-server
# time by Vite (frontend/src/services/api.js) via import.meta.env.VITE_API_URL.
#
# Default when unset is http://127.0.0.1:8000 (see api.js), which matches
# both the manual "uvicorn app.main:app --reload" setup and Docker Compose's
# published backend port -- so this file only needs to be copied/edited if
# your backend is reachable somewhere else (a different port, a remote host,
# etc.). This runs in the evaluator's browser, not inside the Docker network,
# so it must always be a host-reachable URL (e.g. http://localhost:8000),
# never an internal Docker Compose service name like "backend:8000".
VITE_API_URL=http://127.0.0.1:8000

# Postgres connection string. Must be a database with the pgvector extension
# available (Supabase has it built in; the docker-compose `db` service uses
# the pgvector/pgvector:pg16 image, which does too).
DATABASE_URL=your_supabase_database_url

# Local model, mandatory for the demo path. Must match a model you've pulled
# with `ollama pull <model>`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# SOFT wall-clock generation budget, not a hard request timeout -- Ollama
# responses are streamed and, if this runs out before the model finishes,
# whatever has been generated so far is returned (trimmed to a clean
# sentence boundary) rather than discarded. ENGINEERING DECISION: 120s is a
# deliberate trade-off for a reproducible local demo, not a guess -- see
# app/config.py's OLLAMA_TIMEOUT_SECONDS comment for the full reasoning and
# the live measurements it's based on. Ship 30 for 30's ~1,240-1,250-word
# target is an IDEAL, not something worth exceeding this budget to reach; a
# locally-generated essay may come back shorter on CPU-only hardware, and
# that's expected. Increase this (or configure GEMINI_API_KEY for cloud
# headroom instead) on slower hardware if responses are consistently cut
# short before saying anything useful. This is also forwarded through
# docker-compose.yml -- setting it here alone has no effect on Docker
# deployments unless it's passed through there too.
OLLAMA_TIMEOUT_SECONDS=120

# Context window and max output tokens sent to Ollama as request-level
# `options`. Without these, Ollama used the model's small default context
# (4096 for llama3.2:3b), which wasn't enough to hold the Ship 30 essay's
# retrieved transcript context AND a full ~1,250-word output at the same
# time -- the essay was observed truncating around ~650 words. num_ctx gives
# input+output room; num_predict caps generated tokens (comfortably above the
# ~1,670 tokens 1,250 words needs, with headroom for the longer HTML-artifact
# skill too). These only raise the ceiling the model is ALLOWED to generate
# up to -- OLLAMA_TIMEOUT_SECONDS above is what actually decides how much of
# that ceiling a slow local model gets time to use before a response is
# returned as-is.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=3000

# Cloud fallback used AUTOMATICALLY when Ollama is unreachable, fails, or
# hits its soft deadline with too little output. Get a free key (no card
# required) at https://aistudio.google.com/apikey. Leave blank to run fully
# offline (requests will fail if Ollama also fails).
GEMINI_API_KEY=your_gemini_api_key
# gemini-2.0-flash and gemini-2.5-flash are both deprecated for new API
# keys -- do not use them. gemini-3.8-flash is Google's headline "current
# stable" model, but real testing against this project's key found it
# returning live 503 "high demand" errors ~1/3 of the time; gemini-3.6-flash
# was 100% reliable in the same testing and is used here instead. Gemini's
# lineup (and capacity) moves fast; check
# https://ai.google.dev/gemini-api/docs/models and re-test for real 503s
# before changing this.
GEMINI_MODEL=gemini-3.6-flash

# OpenAI is fully wired but INTENTIONALLY not part of the automatic
# fallback chain -- it's reachable only via an explicit provider="openai"
# request or FORCE_LLM_PROVIDER=openai below, so an unfunded or
# intentionally-reserved key is never silently used. Leave blank until you
# have credits and choose to opt in explicitly.
OPENAI_API_KEY=your_openai_api_key

# Force a specific provider for every request, bypassing the normal
# Ollama-first/Gemini-fallback logic. Leave blank for normal behavior.
# One of: ollama | gemini | openai | (blank)
FORCE_LLM_PROVIDER=

# Cosine-similarity floor below which a retrieved chunk is treated as noise,
# not evidence -- this is what lets the assistant say "I don't know"
# structurally for out-of-domain questions. See app/rag/retriever.py.
RAG_MIN_SIMILARITY=0.30

# Agent layer (app/agent/orchestrator.py): the Claude Agent SDK classifies
# chat intent (chat / essay / html_artifact). The `claude-agent-sdk` pip
# package (see requirements.txt) already bundles the Claude Code CLI binary
# it needs for Windows/Linux/macOS -- `pip install -r requirements.txt` is
# enough. You do NOT need to separately install `@anthropic-ai/claude-code`
# via npm, and no `claude` CLI needs to be on PATH.
#
# Set ANTHROPIC_API_KEY below and the SDK authenticates with it directly --
# this is the documented, reproducible path. (The bundled CLI can also pick
# up an interactive `claude login` session from a local machine, but that
# session lives outside this repo and isn't something an evaluator should
# need to set up.)
#
# If the SDK is unavailable for any reason (no key configured, network
# unreachable, etc.), routing degrades automatically to a local heuristic
# classifier -- the app keeps working either way. Set AGENT_SDK_ENABLED to
# false to skip the SDK attempt entirely (useful for a guaranteed
# fully-offline demo, since Ollama is the only requirement that actually
# has to work for the mandatory local-model path).
AGENT_SDK_ENABLED=true
ANTHROPIC_API_KEY=your_anthropic_api_key

# Comma-separated extra origins allowed to call the API, beyond the
# localhost dev ports already allowed by default.
CORS_ORIGINS=
